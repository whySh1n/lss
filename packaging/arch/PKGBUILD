# Maintainer: LinuxShare Contributors
pkgname=linux-screen-share
pkgver=0.1.1
pkgrel=2
pkgdesc="Share your Linux screen as a virtual webcam (CLI + GTK4 GUI)"
arch=('any')
url="https://github.com/whySh1n/linux-screen-share"
license=('MIT')
depends=(
    'python'
    'python-gobject'
    'gtk4'
    'libadwaita'
    'ffmpeg'
    'pipewire'
    'gstreamer'
    'gst-plugin-pipewire'
    'gst-plugins-base'
    'gst-plugins-good'
    'xorg-xrandr'
    'xdg-desktop-portal'
    'v4l2loopback-dkms'
)
optdepends=(
    'xdotool: X11 window listing in the GUI'
    'libappindicator-gtk3: system tray icon'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
# Local checkout recipe: no unverified remote release archives.
# Run from packaging/arch in a trusted checkout. Release recipes must use
# independently verified checksums before adding downloaded source archives.
source=()
sha256sums=()

build() {
    cd "$startdir/../.."
    python -m build --wheel --no-isolation --outdir "$srcdir/wheels"
}

package() {
    cd "$startdir/../.."
    python -m installer --destdir="$pkgdir" "$srcdir"/wheels/*.whl

    # Desktop entry, icon and man page.
    install -Dm644 desktop/linuxshare.desktop \
        "$pkgdir/usr/share/applications/linuxshare.desktop"
    install -Dm644 icons/linuxshare.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/linuxshare.svg"
    install -Dm644 man/linuxshare-cli.1 \
        "$pkgdir/usr/share/man/man1/linuxshare-cli.1"
    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
